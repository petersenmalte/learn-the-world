    "data:learning": "python3 scripts/prepare-learning.py"
  },
  "dependencies": {
    "maplibre-gl": "6.11.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "tsx": "^4.20.0"
  }
}
